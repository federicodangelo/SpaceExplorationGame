## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.csproj.user
*.userprefs

# Rider
.idea/

# NuGet
*.nuget.props
*.nuget.targets
packages/
project.lock.json

# OS
Thumbs.db
.DS_Store

# Build
*.dll
*.exe
*.pdb
*.cache

# External tools
*.bat
gource.*
