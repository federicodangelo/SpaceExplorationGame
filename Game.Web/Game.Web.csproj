<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <RootNamespace>SpaceExplorationGame</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <InvariantTimezone>true</InvariantTimezone>
        <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
        <!-- Suppress CA1416: JSExport is browser-only, which is our target -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Game\Game.csproj" />
        <ProjectReference Include="..\Engine.Web\Engine.Web.csproj" />
    </ItemGroup>
    <ItemGroup>
        <WasmExtraFilesToDeploy Include="wwwroot\index.html" />
    </ItemGroup>
</Project>
